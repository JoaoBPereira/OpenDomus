# Database (DB_HOST, DB_NAME and DB_USER are required)
# with docker compose use the database service name: DB_HOST=opendomus_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=change-me
DB_USER=change-me
DB_PASSWORD=change-me

# docker-compose postgres service
POSTGRES_PASSWORD=change-me
PGDATA=/var/lib/postgresql/data

# REST API (JWT_SECRET is required; ADMIN_PASSWORD is used once, to create the admin user)
PORT=4000
JWT_SECRET=change-me
ADMIN_PASSWORD=change-me
CORS_ORIGINS=
MCP_AUTH_TOKEN=

# API keys the devices and phone apps send in the URL
SAVE_TAG_VALUE_API_KEY=change-me
LOCATION_POST_API_KEY=change-me

# WhatsApp alerts (callmebot.com)
WHATSAPP_PHONE=
WHATSAPP_API_KEY=

# Devices
ECOFOREST_AUTH=
ROHAN_AIR_TUYA_ID=
ROHAN_AIR_TUYA_KEY=
RENAULT_USERNAME=
RENAULT_PASSWORD=
RENAULT_COUNTRY=PT


# House location, used by sunrise/sunset automation triggers (skipped when empty)
LATITUDE=
LONGITUDE=

# Backend server URL for the frontend / backoffice to communicate with the backend 
BACKEND_SERVER_URL=http://127.0.0.1:4000/
# Electricity price shown by the dashboard (written to its config.json by the container)
PRICE_KWH=0.16377
